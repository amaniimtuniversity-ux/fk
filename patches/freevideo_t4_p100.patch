diff --git a/freevideo_engine/backends/cuda_attention.py b/freevideo_engine/backends/cuda_attention.py
index 5978359..0dbde89 100644
--- a/freevideo_engine/backends/cuda_attention.py
+++ b/freevideo_engine/backends/cuda_attention.py
@@ -7,6 +7,15 @@ class CUDAAttentionKernels:
         choices = ('cudnn', 'torch-flash', 'sage2', 'fa2', 'fa4')
         if global_backend not in choices or window_backend not in choices:
             raise ValueError('Unknown CUDA attention backend')
+        # T4/P100 guard: FA2/FA4/Sage2 require SM80+. Fail fast with a clear
+        # message instead of a cryptic Triton/CUDA error deep in the stack.
+        import os as _os
+        if _os.environ.get('FREEVVIDEO_T4_P100', '') == '1':
+            import torch as _t
+            if _t.cuda.is_available() and _t.cuda.get_device_capability() < (8, 0):
+                if global_backend in ('fa2', 'fa4', 'sage2') or window_backend in ('fa2', 'fa4', 'sage2'):
+                    raise ValueError(
+                        'FA2/FA4/Sage2 require SM80+. On T4/P100 use cudnn or torch-flash (SDPA).')
         if 'fa4' in (global_backend, window_backend):
             from ..fa4_guard import check_selected
             check_selected()
